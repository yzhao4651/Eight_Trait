myGAPIT <- GAPIT(#
  Y=myY,#
  GD=myGD,#
  GM=myGM,#
  CV=myQ,#
  SNP.MAF =0.05,#
  sangwich.top="CMLM", #options are GLM,MLM,CMLM, FaST and SUPER #
  sangwich.bottom="SUPER", #options are GLM,MLM,CMLM, FaST and SUPER #
  LD=0.1#
)
