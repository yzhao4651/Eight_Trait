str(myY1)#
#
Yldmakingup <- read.csv("data/alltraitsyldmakeup.csv",row.names=1)#
Yldmakingup <- Yldmakingup[,c(1,4:6,3)]#
str(Yldmakingup)#
#
Yld <- merge(myY1,Yldmakingup, by="Taxa", all.x =TRUE)#
str(Yld)#
Yld <- merge(myY1,Yldmakingup, by="Taxa", all.y=TRUE)#
Yld_1 <- Yld[,c(1,43)]#
str(Yld_1)#
myY <- Yld_1#
myGD <- read.csv("data/myGDimputedSNP19.csv")#
myGM <- read.csv("data/myGMimputedSNP19.csv")#
myQ <- read.csv("data/myQimputedSNP19.csv")#
###install the packaged need for GAPIT
